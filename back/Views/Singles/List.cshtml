<!DOCTYPE html>
<html>
<head>
    <title>Tabbed Content</title>
    <style>
        .tabcontent {
            display: none;
        }
    </style>
</head>
<body>



    <div id="tab1" class="tabcontent">
        <div class="row mt-5 mb-2">
            @foreach (var single in Model.AllSingles)
            {
                @if (single.pageID == 1)
                {
                    <div class="col-lg-4">
                        <img class="img-thumbnail" src="@single.img" alt="@single.name" />
                        <h2>@single.name</h2>
                        <p>@single.singer</p>
                        <p>@single.genre</p>

                        <form action="@single.spotifyLink" method="get" target="_blank">
                            <button class="btn-danger">Spotify</button>
                        </form>

                        <form action="@single.appleMusicLink" method="get" target="_blank">
                            <button class="btn-danger">Apple</button>
                        </form>

                        <form action="@single.youtubeLink" method="get" target="_blank">
                            <button class="btn-danger">Youtube</button>
                        </form>

                        <form action="@single.deezerLink" method="get" target="_blank">
                            <button class="btn-danger">Dezzer</button>
                        </form>
                    </div>
                }
            }
        </div>
    </div>

